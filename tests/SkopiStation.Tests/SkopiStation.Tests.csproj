<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The patient list ViewModel filters and sorts through ICollectionView, which lives in
         WindowsBase; testing it means referencing the WPF assemblies. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkopiStation.App\SkopiStation.App.csproj" />
    <ProjectReference Include="..\..\src\SkopiStation.Data\SkopiStation.Data.csproj" />
    <ProjectReference Include="..\..\src\SkopiStation.Devices\SkopiStation.Devices.csproj" />
    <ProjectReference Include="..\..\src\SkopiStation.Domain\SkopiStation.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
