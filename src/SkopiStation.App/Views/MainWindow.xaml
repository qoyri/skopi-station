<Window x:Class="SkopiStation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SkopiStation.App.Views"
        xmlns:viewModels="clr-namespace:SkopiStation.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:ShellViewModel}"
        Title="skopi-station" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,10" Background="#F5F5F5">
            <StackPanel>
                <TextBlock Text="skopi-station" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" Opacity="0.6" FontSize="12" />
            </StackPanel>
        </Border>

        <views:PatientListView DataContext="{Binding Patients}" />
    </DockPanel>
</Window>
