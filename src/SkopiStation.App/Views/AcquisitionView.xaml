<UserControl x:Class="SkopiStation.App.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:SkopiStation.App.Converters"
             xmlns:viewModels="clr-namespace:SkopiStation.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:AcquisitionViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:OutOfRangeBrushConverter x:Key="OutOfRangeBrush" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>

        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.6" />
            <ComboBox ItemsSource="{Binding AvailablePorts}"
                      SelectedItem="{Binding SelectedPort}"
                      MinWidth="120" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" Padding="10,3" />
            <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="16,0,0,0" Padding="14,3" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="8,0,0,0" Padding="14,3" />

            <Ellipse Width="10" Height="10" Margin="20,0,6,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#9E9E9E" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="#27AE60" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ReceivedMeasurements}"
                      SelectedItem="{Binding SelectedMeasurement}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Received" Binding="{Binding TakenAt, StringFormat=T}" Width="90" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                    <DataGridTextColumn Header="Value" Width="90">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Value" />
                                <Binding Path="Unit" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground"
                                        Value="{Binding IsOutOfRange, Converter={StaticResource OutOfRangeBrush}}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" />
                    <DataGridTextColumn Header="Filed under" Binding="{Binding AttachedTo}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="File to a patient" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedPatientName}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="Pick a patient on the Patients tab, then a reading on the left."
                               Opacity="0.5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="File selected reading" Command="{Binding AttachCommand}"
                            Margin="0,10,0,0" Padding="12,5" HorizontalAlignment="Left" />

                    <Separator Margin="0,20,0,0" />

                    <TextBlock Text="Manual entry" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="Recorded with Source = Manual." Opacity="0.5" FontSize="11" />

                    <StackPanel DataContext="{Binding ManualEntry}">
                        <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />

                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Value in" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox x:Name="ManualValueBox"
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Style="{StaticResource FieldError}"
                                   Text="{Binding ElementName=ManualValueBox,
                                                  Path=(Validation.Errors)/ErrorContent}" />
                    </StackPanel>

                    <Button Content="Add reading" Command="{Binding AddManualEntryCommand}"
                            Margin="0,12,0,0" Padding="12,5" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Opacity="0.6" FontSize="11"
                   Text="Readings stay in this list until they are filed; disconnecting does not discard them." />
    </Grid>
</UserControl>
