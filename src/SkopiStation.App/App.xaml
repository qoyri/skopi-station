<Application x:Class="SkopiStation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SkopiStation.App.Converters"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <!-- Shared by both screens. They live here rather than in each view because they carry the
             presentation of validation messages and of out-of-range readings: two copies would
             drift apart the first time only one of them was edited. -->
        <converters:OutOfRangeBrushConverter x:Key="OutOfRangeBrush" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>

        <!-- Messages published through INotifyDataErrorInfo. They sit in the normal layout flow
             rather than in a Validation.ErrorTemplate adorner, so they are laid out with the form
             and remain reachable to accessibility tools. The (Validation.Errors)/ErrorContent
             syntax binds to the current item of the collection, which yields an empty string
             instead of a binding failure when the field is valid. -->
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
